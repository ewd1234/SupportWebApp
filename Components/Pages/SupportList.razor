@page "/support-list"
@rendermode InteractiveServer
@using System.Linq
@using SupportWebApp.Models
@using SupportWebApp.Services
@inject ICosmosDbService CosmosDbService

<PageTitle>Supporthenvendelser</PageTitle>

<h3>Modtagne Supporthenvendelser</h3>
<h4>V2</h4>

<!-- AI -->
<!-- Dropdown til filtrering -->
<div class="mb-4 row align-items-center">
    <label for="categorySelect" class="col-auto col-form-label fw-bold">Filtrér efter kategori:</label>
    <div class="col-auto">
        <select id="categorySelect" class="form-select" @onchange="OnCategoryChanged">
            <option value="Alle">Alle</option>
            <option value="Forhandler">Forhandler</option>
            <option value="Reservedele">Reservedele</option>
            <option value="Købsrådgivning">Købsrådgivning</option>
            <option value="Produktforslag">Produktforslag</option>
            <option value="Katalogbestilling">Katalogbestilling</option>
            <option value="Øvrigt">Øvrigt</option>
        </select>
    </div>
</div>

@if (isLoading)
{
    <p><em>Henter henvendelser fra CosmosDB...</em></p>
}
else if (supportMessages == null || !supportMessages.Any())
{
    <div class="alert alert-info">Der er endnu ingen supporthenvendelser registreret i denne kategori.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Dato</th>
                    <th>Kategori</th>
                    <th>Navn</th>
                    <th>E-mail</th>
                    <th>Telefon</th>
                    <th>Beskrivelse</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in supportMessages)
                {
                    <tr>
                        <td>@item.DateTime.ToString("dd-MM-yyyy HH:mm")</td>
                        <td><span class="badge bg-primary">@item.Category</span></td>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>@item.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<SupportMessage>? supportMessages;
    private bool isLoading = true;
    private string selectedCategory = "Alle";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString() ?? "Alle";
        await LoadDataAsync();
    }
//AI
    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            if (string.IsNullOrEmpty(selectedCategory) || selectedCategory == "Alle")
            {
                supportMessages = await CosmosDbService.GetSupportMessagesAsync();
            }
            else
            {
                supportMessages = await CosmosDbService.GetSupportMsgByCategoryAsync(selectedCategory);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fejl ved hentning af henvendelser: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}